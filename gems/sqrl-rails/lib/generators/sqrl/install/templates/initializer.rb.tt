# frozen_string_literal: true

# SQRL login (sqrl-rails). Every option is documented in SQRL::Rails::Configuration.
Rails.application.config.sqrl.tap do |sqrl|
  # The public host (and port, when not the default) placed in the sqrl:// login URLs.
  # SQRL identities are derived from this host, so it must be the name users see.
  # When nil, the host of each request is used.
<% if host_option -%>
  sqrl.host = <%= host_option.inspect %>
<% else -%>
  sqrl.host = ENV["SQRL_HOST"].presence
<% end -%>

  # The user model.
  sqrl.user_class = <%= options[:user_model].classify.inspect %>

  # What to do when an unknown SQRL identity logs in:
  #   :create  create an account for it (the SQRL default; see sqrl.create_user)
  #   :link    only accept it while a user is signed in, and attach it to that user
  #   :refuse  reject it
  sqrl.on_unknown_identity = :create

  # How a user is created for a new identity under :create. The default
  # (SQRL::Rails::UserFactory) fills in placeholders for the columns your model has:
  # a random password for has_secure_password and a non-routable email address.
  # Replace it to collect real details, for example by redirecting to a profile form.
  # sqrl.create_user = ->(identity) { User.create!(name: "SQRL user", password: SecureRandom.hex(32)) }

  # How the user is signed in. By default the Authentication concern generated by
  # `bin/rails generate authentication` is used (start_new_session_for); without it,
  # session[:user_id] is set. Devise users should use the devise-sqrl gem instead.
  # sqrl.sign_in = ->(controller, identity, user) { controller.send(:start_new_session_for, user) }

  # Where to go after signing in (a same-site return_to recorded at login time wins).
  # sqrl.after_sign_in = ->(controller, completion) { controller.send(:after_authentication_url) }

  # Where to go when a login cannot be completed (default: the engine's login page).
  # sqrl.failure_path = "/session/new"

  # Protocol options (see SQRL::Server::Config): sqrl.nut_ttl, sqrl.cps_token_ttl,
  # sqrl.require_ip_match, sqrl.path_extension, sqrl.on_authenticated.

  # Optional hardening: refuse to complete a login through the page's poller (no CPS
  # token) when the SQRL client's IP did not match the browser's. Off by default because
  # a phone on another network is a normal SQRL login.
  # sqrl.poll_requires_ip_match = true

  # Loopback-only testing mode: issue qrl:// (plain http) URLs so the browser extension's
  # test client can log in to `bin/rails server` without TLS. qrl:// is not part of the
  # final SQRL specification and real clients refuse it; it is rejected for any host that
  # is not loopback.
  # sqrl.insecure_http = Rails.env.development? && ENV["SQRL_INSECURE_HTTP"].present?

  # Ask the user a question on every login (the client shows it with the buttons; the
  # answer arrives as btn=1 or btn=2). ask_deny_button names the button that refuses
  # the login. SQRL_ASK=1 turns the example question on for testing.
  if ENV["SQRL_ASK"].present?
    sqrl.ask = SQRL::Ask.new(message: "Allow this login?", buttons: [{ label: "Allow" }, { label: "Deny" }],
                             accept: [1])   # only "Allow" lets the ident proceed
    sqrl.ask_deny_button = 2               # and a "Deny" that slips through is refused at the callback
  end

  # Secret index: the server sends sin= and the client answers with ins=, a per-site
  # secret derived from its identity, which the site can use as an extra factor.
  sqrl.sin = "0" if ENV["SQRL_SIN"].present?

  # Rate limit for the protocol endpoint and the login page, per client IP, counted in
  # Rails.cache. nil disables it.
  # sqrl.rate_limit = { to: 60, within: 1.minute }

  # Hosts a request may use when sqrl.host is not set (Strings or Regexps), and how many
  # distinct request hosts are kept per process; nuts and pending logins are pruned
  # opportunistically every prune_every handled requests.
  # sqrl.allowed_hosts = ["example.com", /\.example\.com\z/]
  # sqrl.host_cache_limit = 16
  # sqrl.prune_every = 1000

  # Hooks run before a login URL is issued and before a protocol request is handled;
  # raise SQRL::Server::RateLimited to refuse (the request gets a 429).
  # sqrl.before_handle = ->(context) { raise SQRL::Server::RateLimited.new(retry_after: 10) if Throttle.hot?(context[:ip]) }

  # Storage: :active_record (default, tables from the sqrl:install migration), :cache
  # (Rails.cache or sqrl.cache_store; needs Redis or Memcached) or :memory.
  sqrl.stores = :active_record
end

# Account policies: a SQRL client can ask the site to refuse password logins (sqrlonly)
# and password recovery (hardlock) for its account. The generator includes
# SQRL::Rails::PasswordPolicy::Sessions / ::Passwords into the generated controllers to
# enforce them; SQRL::Rails.sqrl_only?(user) and SQRL::Rails.hard_locked?(user) are
# available for your own code. Users can review their identities at /sqrl/identities.
