<h1>Devise + SQRL</h1>
<% if user_signed_in? %>
  <p id="status">Signed in as <strong><%= current_user.email %></strong>
    (<%= pluralize(current_user.sqrl_identities.count, "SQRL identity") %>).</p>
  <p><%= link_to "Protected page", protected_path %> &middot;
     <%= link_to "Manage SQRL identities", identities_user_sqrl_path, id: "sqrl-identities" %></p>
  <% if current_user.sqrl_only? %><p id="sqrl-only">This account signs in with SQRL only.</p><% end %>
  <%= button_to "Log out", destroy_user_session_path, method: :delete %>
<% else %>
  <p id="status">You are not signed in.</p>
  <p><%= link_to "Sign in", new_user_session_path %> &middot;
     <%= link_to "Sign in with SQRL only", new_user_sqrl_path %></p>
<% end %>
